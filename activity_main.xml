<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E17">

    <!-- CameraX Live Viewfinder -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/metricsScrollView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Overlay Targeting Reticle for UPI QR / Payee Screen -->
    <View
        android:id="@+id/reticleOverlay"
        android:layout_width="280dp"
        android:layout_height="220dp"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="@+id/viewFinder"
        app:layout_constraintEnd_toEndOf="@+id/viewFinder"
        app:layout_constraintStart_toStartOf="@+id/viewFinder"
        app:layout_constraintTop_toTopOf="@+id/viewFinder" />

    <!-- Top Floating Header Bar -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="#D9111827"
        android:elevation="6dp"
        android:orientation="horizontal"
        android:padding="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEEPSHIELD MOBILE"
                android:textColor="#00F0FF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="iQOO Edge NPU • Sub-10ms Dual-Modal"
                android:textColor="#9CA3AF"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvVerdictBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#064E3B"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="PROTECTED"
            android:textColor="#10B981"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Metrics & IPC Status Scroll View -->
    <ScrollView
        android:id="@+id/metricsScrollView"
        android:layout_width="0dp"
        android:layout_height="320dp"
        android:background="#111827"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Visual Channel Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1F2937"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VISUAL VERIFICATION (CameraX YUV Zero-Copy)"
                    android:textColor="#60A5FA"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvVisualScore"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Anomaly: 0.04 (Normal)"
                        android:textColor="#F3F4F6"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvVisualLatency"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Latency: 3.8ms"
                        android:textColor="#34D399"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvKerningInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Kerning Variance: 2.1 • Moiré Index: 0.3%"
                    android:textColor="#9CA3AF"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Acoustic Channel Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#1F2937"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACOUSTIC VERIFICATION (Native C++ Oboe 16kHz)"
                    android:textColor="#F59E0B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvAcousticScore"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Box Resonance (1.2-3.5kHz): 62%"
                        android:textColor="#F3F4F6"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvReplayStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AUTHENTIC BOX"
                        android:textColor="#10B981"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pbResonanceRatio"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="6dp"
                    android:max="100"
                    android:progress="62"
                    android:progressTint="#10B981" />
            </LinearLayout>

            <!-- OriginOS Office Kit IPC Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#1F2937"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ORIGINOS OFFICE KIT POS BRIDGE"
                    android:textColor="#A78BFA"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOfficeKitSession"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Session: E3F1-9A70-OFFLINE"
                    android:textColor="#E5E7EB"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvCryptogramDigest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:text="HMAC-SHA256: 7f83b1657ff1fc53b92dc18148a1d65dfc2d4b1f"
                    android:textColor="#9CA3AF"
                    android:textSize="10sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
